# --- Telegram personal account (Telethon) ---
# Obtain at https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=change_me

# --- Bot control panel ---
BOT_TOKEN=123456:CHANGE_ME
# Whitelisted admin Telegram user IDs (comma-separated, numeric — not @usernames)
ADMIN_USER_IDS=111111111

# Private "drafts" channel where you write announcements. The service reads
# templates from here. Numeric id (e.g. -1001234567890) or @username.
DRAFTS_CHANNEL=@my_teasender_drafts

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://teasender:teasender@localhost:5432/teasender
# Fernet key that encrypts the Telethon session at rest.
SECRET_KEY_FILE=./data/secret.key
# Encrypted session blob location.
SESSION_FILE=./data/session.enc

TIMEZONE=Europe/Istanbul

# --- Safety ---
# When true, plan and log everything but DO NOT actually send. Start here.
DRY_RUN=true
# Hard floor between any two sends across all chats, seconds.
GLOBAL_MIN_SEND_INTERVAL=45
# Pause all posting automatically if the account hits a spam limit.
AUTO_PAUSE_ON_FLOOD=true

# --- Postgres container (used by docker-compose) ---
POSTGRES_USER=teasender
POSTGRES_PASSWORD=teasender
POSTGRES_DB=teasender
